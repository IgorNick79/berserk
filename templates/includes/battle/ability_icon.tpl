<span class="panel-stat-hint panel-ability" data-ability="{{ability}}" tabindex="0" role="button" aria-label="{{label}}">
    <img class="panel-ability-icon" src="/assets/images/icons/icon-{{ability}}.png" alt="" width="20" height="20" onerror="this.parentElement.hidden=true">
    <span>{{value}}</span>
    <span class="battle-icon-tooltip" aria-hidden="true">{{label}}</span>
</span>
