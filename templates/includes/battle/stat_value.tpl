<span class="panel-stat-hint panel-stat-value" data-stat="{{stat}}" tabindex="0" role="button" aria-label="{{label}}">
    <img class="panel-stat-value-icon" src="/assets/images/card/{{icon}}.png" alt="" width="24" height="24">
    <span class="panel-stat-number">{{value}}</span>
    <span class="battle-icon-tooltip" aria-hidden="true">{{label}}</span>
</span>
