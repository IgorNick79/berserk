<div class="prepare-card-preview">
    <div class="prepare-card-preview__media">
        {{image_html}}
    </div>
    <div class="prepare-card-preview__info">
        <h3>{{name}}</h3>
        <div class="prepare-card-preview__meta">{{ukid}} {{instance_id}}</div>
        <div>Стихия: {{element}}</div>
        <div>HP {{health}}/{{hp_max}} | MV {{move}}</div>
        <div>Удары: {{weak}}/{{medium}}/{{strong}}</div>
        <div>Цена: {{price}}</div>
    </div>
    {{actions_html}}
</div>
