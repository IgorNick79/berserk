<a class="draft-card-link" href="{{link}}">
    <div class="card draft-card {{card_class}} {{elite}}">
        <div class="card__name">{{name}}</div>
        <div class="card__element">{{element}}</div>
        <div class="card__stats">
            HP {{health}} | MV {{move}} | У {{weak}}/{{medium}}/{{strong}}
        </div>
        <div class="card__price">Цена: {{price}}</div>
    </div>
</a>