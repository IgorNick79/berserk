<div class="prepare-panel">
    <div class="prepare-panel__media">
        {{image_html}}
    </div>
    <div class="prepare-panel__info">
        <h3>{{name}}</h3>
        <div class="prepare-panel__meta">{{ukid}} {{instance_id}}</div>
        <div>Стихия: {{element}}</div>
        <div>HP {{health}}/{{hp_max}} | MV {{move}}</div>
        <div>Удары: {{weak}}/{{medium}}/{{strong}}</div>
        <div>Цена: {{price}}</div>
    </div>
    <div class="prepare-panel__actions">
        {{actions_html}}
    </div>
</div>
