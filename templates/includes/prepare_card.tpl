<a class="prepare-card-link {{class}}" href="{{link}}" data-ukid="{{ukid}}" data-instance-id="{{instance_id}}">
    <div class="prepare-card{{selected}}{{disabled}}{{elite}}">
        <div class="prepare-card__name">{{name}}</div>
        {{count_html}}
        <div class="prepare-card__element">{{element}}</div>
        <div class="prepare-card__stats">
            HP {{health}} | MV {{move}} | У {{weak}}/{{medium}}/{{strong}}
        </div>
        <div class="prepare-card__price">Цена: {{price}}</div>
    </div>
</a>
