<article class="pregame-card-info">
    {{image_html}}
    <div class="pregame-card-stats" aria-label="Характеристики карты">
        <span><b>HP</b> {{hp}}</span>
        <span><b>Strike</b> {{strike}}</span>
        <span><b>Move</b> {{move}}</span>
        {{rarity_html}}
        {{element_html}}
    </div>
    <div class="pregame-card-details"><h3>{{name}}</h3>{{description_html}}</div>
</article>
