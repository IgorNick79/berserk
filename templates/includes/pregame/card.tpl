<article class="pregame-card-info">
    <div class="pregame-card-heading">
        <span class="pregame-card-cost" aria-label="Стоимость: {{price}}">{{cost_icon_html}}<span>{{price}}</span></span>
        <h3 class="pregame-card-title">{{name}}</h3>
        <div class="pregame-card-heading-icons">{{element_html}}{{rarity_html}}</div>
    </div>
    <div class="pregame-card-media">{{image_html}}</div>
    <div class="pregame-card-stats" aria-label="Характеристики карты">
        <div class="pregame-stats-main">{{stat_values_html}}</div>
        <div class="pregame-stats-extra">{{class_html}}{{description_html}}</div>
    </div>
</article>
